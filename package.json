{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bruhno/homepage",
  "description": "My personal portfolio and playground",
  "homepage": "https://bruhno.com",
  "author": "Nicolai Bruhn Lauritsen <mail@bruhno.com> (https://bruhno.com)",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not op_mini all",
    "node > 20"
  ],
  "scripts": {
    "build:analyze": "cross-env ANALYZE_BUILD=true next build",
    "build:debug": "next build --debug",
    "build:env": "node scripts/createEnv.js",
    "build:ladle": "ladle build",
    "build:next": "next build",
    "build:profile": "next build --profile",
    "build:sitemap": "node scripts/createSitemap.js",
    "build": "concurrently -p \"[{name}]\" -n \"next,sitemap,env,ladle\" -c \"blue,yellow,cyan,white\" -s \"all\" \"pnpm build:next\" \"pnpm build:sitemap\" \"pnpm verify:env\" \"pnpm build:ladle\"",
    "db:studio": "prisma studio",
    "db:generate-schema": "prisma generate",
    "debug": "cross-env NODE_OPTIONS='--inspect' next dev",
    "dev:ladle": "ladle serve",
    "dev:next": "next",
    "dev": "concurrently -p \"[{name}]\" -n \"next,ladle\" -c \"blue,white\" -s \"all\" -k \"true\" \"pnpm dev:next\" \"pnpm dev:ladle\"",
    "lint:eslint": "eslint . --ext js,mjs,ts,tsx --quiet",
    "lint:tsc": "tsc --project tsconfig.json --noEmit",
    "lint": "concurrently -p \"[{name}]\" -n \"eslint,tsc\" -c \"magenta,blue\" -s \"all\" -r \"pnpm lint:eslint\" \"pnpm lint:tsc\"",
    "postinstall": "pnpm db:generate-schema",
    "start": "next start",
    "start:amqp": "sudo lavinmq -D /var/lib/lavinmq",
    "start:redis": "sudo service redis-server start",
    "test": "jest",
    "verify:env": "node scripts/verifyEnv.js"
  },
  "dependencies": {
    "@cloudamqp/amqp-client": "^3.1.1",
    "@emotion/react": "11.13.0",
    "@emotion/server": "^11.11.0",
    "@hookform/resolvers": "3.9.0",
    "@nivo/core": "0.87.0",
    "@nivo/line": "0.87.0",
    "@node-rs/argon2": "^1.8.3",
    "@node-rs/jsonwebtoken": "^0.5.6",
    "@prisma/client": "5.17.0",
    "@react-aria/focus": "3.18.1",
    "@react-aria/interactions": "3.22.1",
    "@react-hook/media-query": "1.1.1",
    "@react-three/drei": "9.109.2",
    "@react-three/fiber": "8.16.8",
    "@sentry/nextjs": "7.116.0",
    "@sentry/tracing": "7.116.0",
    "@tabler/icons-react": "3.11.0",
    "@vercel/analytics": "1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "cookie": "0.6.0",
    "date-fns": "3.6.0",
    "downshift": "9.0.7",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.17.21",
    "match-sorter": "6.3.4",
    "next": "14.2.5",
    "next-connect": "0.13.0",
    "otplib": "12.0.1",
    "qrcode": "1.5.3",
    "radash": "^12.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.52.2",
    "react-lite-youtube-embed": "2.4.0",
    "react-textarea-autosize": "8.5.3",
    "resize-observer-polyfill": "1.5.1",
    "superstruct": "2.0.2",
    "swr": "2.2.5",
    "three": "0.167.1",
    "ts-custom-error": "3.3.1",
    "undici": "6.19.5",
    "uuid": "10.0.0",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "10.2.8",
    "@emotion/eslint-plugin": "11.12.0",
    "@ladle/react": "4.1.0",
    "@next/bundle-analyzer": "14.2.5",
    "@sentry/types": "7.116.0",
    "@types/cookie": "0.6.0",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/lodash": "4.17.7",
    "@types/node": "22.1.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/supertest": "6.0.2",
    "@types/three": "0.167.1",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "28.6.0",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "7.0.0",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-tsdoc": "0.3.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lodash-webpack-plugin": "0.11.6",
    "node-mocks-http": "1.15.1",
    "prisma": "5.17.0",
    "react-inspector": "6.0.2",
    "supabase": "^1.187.10",
    "supertest": "7.0.0",
    "type-fest": "4.23.0",
    "typescript": "5.5.4",
    "vite": "5.3.5",
    "web-streams-polyfill": "^4.0.0",
    "webpack": "5.93.0",
    "zx": "^8.1.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "@node-rs/argon2@1.8.3": "patches/@node-rs__argon2@1.8.3.patch",
      "@node-rs/jsonwebtoken@0.5.6": "patches/@node-rs__jsonwebtoken@0.5.6.patch"
    }
  }
}
